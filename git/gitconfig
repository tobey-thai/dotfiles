# vim: ft=gitconfig
[core]
    editor = vim
[pull]
    ff = only
[submodule]
    recurse = false
[alias]
    aliases = "! git config --get-regexp ^alias\\. | sed -e 's/\\(^alias\\)\\./\\1 = /'"
    a = add
    au = add --update
    aup = add --update --patch
    b = branch
    c = commit
    d = diff
    f = fetch
    fp = fetch --prune
    l = log --graph --date-order --name-only
    l1 = log --graph --oneline --date-order
    ln = log --graph --oneline --date-order --name-only
    m = merge
    o = checkout
    s = status
    t = status
    hs = show --stat
    gs = grep --recurse-submodules
    gst = grep --recurse-submodules --untracked
    gni = grep --no-index

    amend = "! git commit --amend --date=\"$(date -R)\""
    ba = branch --all
    bac = branch --all --contains
    bal = branch --all --list
    bd = branch --delete
    bdf = branch --delete --force
    bvv = branch -vv
    cp = cherry-pick
    cpa = cherry-pick --abort
    cpc = cherry-pick --continue
    ds = diff --staged
    rs = restore
    rss = restore --staged
    rb = rebase
    rba = rebase --abort
    rbc = rebase --continue
    rbi = rebase --interactive
    rbs = rebase --skip
    rl = reflog

    su = submodule update --remote --rebase
    ss = submodule foreach git status
[credential]
    helper = cache --timeout 28800
